# Public bucket (site reads directly, no auth) — worker syncs here
# Bucket: hf://buckets/swadhinbiswas/bangladeshi-jobs  (aliased as dataset swadhinbiswas/bangladeshi-jobs)
# CDN: https://huggingface.co/datasets/swadhinbiswas/bangladeshi-jobs/resolve/main/gold/stats.json
NEXT_PUBLIC_HF_DATASET=swadhinbiswas/bangladeshi-jobs
NEXT_PUBLIC_HF_BUCKET=hf://buckets/swadhinbiswas/bangladeshi-jobs
HF_DATASET=swadhinbiswas/bangladeshi-jobs
HF_BUCKET=hf://buckets/swadhinbiswas/bangladeshi-jobs
HF_TOKEN=hf_xxx  # needed only for worker push (writes), reads are public

# Local dev fallback: dashboard falls back to /public/gold (copied from data/gold at build) if HF not reachable
# Run: python warehouse/build.py && mkdir -p dashboard/public/gold && cp -r data/gold/* dashboard/public/gold/
